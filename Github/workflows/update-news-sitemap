name: Sync Google Sheet News + Ads to GitHub

on:
  repository_dispatch:
    types: [news_updated]
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      - name: Sync Google Sheet to GitHub
        run: python3 tools/generate_static_news.py
      - name: Commit synced data
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add news-data.json ads-data.json assets/news-media sitemap.xml news-sitemap.xml
          if git diff --cached --quiet; then
            echo "No changes to sync."
          else
            git commit -m "Sync Google Sheet data"
            git push
          fi
